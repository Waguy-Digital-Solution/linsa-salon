rules_version = '2';

/* ============================================================
   Linsa Salon de Beauté — Règ Sekirite Firestore
   ============================================================
   KIJAN POU APLIKE L (2 ETAP OBLIGATWA):
   1. Firebase Console → Authentication → Sign-in method → aktive
      "Email/Password". Epi tab "Users" → "Add user" → kreye DE kont,
      ak MENM email/modpas ki nan staff/index.html (USERS.linsa.authEmail/
      authPassword ak USERS.marie...). San etap sa a, app kès la p ap ka
      li/modifye randevou ankò (li ap resevwa "permission-denied").
   2. Firebase Console → Build → Firestore Database → tab "Rules" →
      ranplase tout kontni ki la a ak fichye sa a → "Publish".

   PRENSIP:
   - Piblik la (paj randevou) SÈLMAN ka kreye yon randevou — yo pa ka li,
     modifye, ni efase okenn randevou (menm pa yo), ni wè non/nimewo lòt
     kliyan.
   - Sèlman app kès la (staff, apre PIN kòrèk konekte otomatikman ak
     Firebase Authentication) ka li/modifye/efase randevou.
   - Pwomosyon: piblik la ka LI sèlman; ekri (ajoute/efase) rezève pou
     app admin/staff la (menm otantifikasyon).
   - Anplwaye & Peman (payroll): SÈLMAN kont Admin (linsa@linsa-salon.local)
     ka li oswa ekri — Kesyè (marie@...) menm si l otantifye pa gen aksè,
     ni piblik la.
============================================================ */

function isValidAppointment(d) {
  return d.keys().hasAll(['name', 'phone', 'date', 'time', 'serviceId'])
    && d.name is string && d.name.size() > 0 && d.name.size() < 120
    && d.phone is string && d.phone.size() > 0 && d.phone.size() < 40
    && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$')
    && (!('note' in d) || (d.note is string && d.note.size() < 500));
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /appointments/{apptId} {
      // Piblik la ka sèlman KREYE yon randevou — done yo dwe valid.
      allow create: if isValidAppointment(request.resource.data);

      // Sèlman staff otantifye (Firebase Auth, gade nòt anwo a) ka li,
      // modifye oswa efase randevou.
      allow read, update, delete: if request.auth != null;
    }

    match /promos/{promoId} {
      // Tout moun ka wè pwomosyon yo (carousel piblik la).
      allow read: if true;
      // Sèlman staff otantifye ka ekri (telechaje/efase pwomosyon).
      allow write: if request.auth != null;
    }

    match /employees/{empId} {
      // Sèlman kont Admin lan gen aksè — pa Kesyè, pa piblik.
      allow read, write: if request.auth != null && request.auth.token.email == 'linsa@linsa-salon.local';
    }

    match /payroll_payments/{payId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'linsa@linsa-salon.local';
    }

    // Tout lòt koleksyon: fèmen pa default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
